# syntax=docker/dockerfile:1

FROM alpine:3.22 AS binary

ARG SCCACHE_VERSION
ARG TARGETARCH

WORKDIR /work
COPY . /work/

RUN set -eux; \
    case "${TARGETARCH}" in \
        amd64) target="x86_64-unknown-linux-musl" ;; \
        arm64) target="aarch64-unknown-linux-musl" ;; \
        *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    artifact="sccache-${SCCACHE_VERSION}-${target}"; \
    test -f "${artifact}/sccache"; \
    cp "${artifact}/sccache" /sccache; \
    chmod +x /sccache

FROM alpine:3.22

RUN apk add --no-cache ca-certificates

COPY --from=binary /sccache /usr/local/bin/sccache

LABEL org.opencontainers.image.title="sccache" \
      org.opencontainers.image.description="Shared Compilation Cache" \
      org.opencontainers.image.source="https://github.com/mozilla/sccache" \
      org.opencontainers.image.licenses="Apache-2.0"

ENTRYPOINT ["sccache"]
CMD ["--help"]
